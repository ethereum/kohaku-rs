+// Instance table for a single pool on a local test chain, from LOCAL_POOL_* env vars.
+function localInstances(netId) {
+  const address = process.env.LOCAL_POOL_ADDRESS
+  if (!address) {
+    return undefined
+  }
+
+  const symbol = process.env.LOCAL_POOL_SYMBOL.toLowerCase()
+  return {
+    [`netId${netId}`]: {
+      [symbol]: {
+        instanceAddress: { [process.env.LOCAL_POOL_AMOUNT]: address },
+        symbol: symbol.toUpperCase(),
+        decimals: Number(process.env.LOCAL_POOL_DECIMALS),
+      },
+    },
+  }
+}
